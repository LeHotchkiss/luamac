version 100

cbb {
    base {
        depends []          # project-local dependencies
        depends_ex []       # external dependencies

        class "exe"

        includes [ ]
        source [ ]
        lib [ ]

        link [ ]
        link_shared [ ]

        compiler "g++"

        cc_args [ ]
        ld_args [ ]

        out "test"
    }
}

targets {
    treesitter {
        concat "cbb.base"

        compiler "gcc"

        source [
            "src/treesittercpp/*.c"
        ]

        includes [
            "src/treesittercpp"
        ]

        class "static"

        out "libtscpp.a"
    }

    main {
        concat "cbb.base"

        depends [
            "treesitter"
        ]

        depends_ex [
            {
                path "hotchlib/hotchlib.cml"
                target "main"
            }

            {
                path "src/lua/default.cml"
                target "static"
            }
        ]

        class "exe"

        includes [
            "." "src"
            "src/lua"
            "src/treesittercpp"
	    "hotchlib/include"
        ]

        source [
            "src/*.cpp"
        ]

        compiler "g++"

        cc_args [
            "-std=c++17"
            "-fno-exceptions"
            "-O2"
	    "-Wall"
        ]

        lib [
            "." "hotchlib"
            "src/lua"
        ]

        link [
            "libhotch.a"
            "liblua.a"
            "libtscpp.a"
        ]

        out "luamac"
    }
}
